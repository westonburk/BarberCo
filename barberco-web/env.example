# Copy to .env.local for local development
#
# BarberCo.Api launch profile (https):
#   API_BASE_URL=https://127.0.0.1:7200/api
# BarberCo.Api launch profile (http only — no TLS workaround needed):
#   API_BASE_URL=http://127.0.0.1:5167/api
#
# Use 127.0.0.1 instead of localhost to avoid IPv6 (::1) connection issues on Windows.
#
# If using https with the dev cert, also set:
#   NODE_TLS_REJECT_UNAUTHORIZED=0
API_BASE_URL=https://127.0.0.1:7200/api
API_KEY=your-api-key-here
