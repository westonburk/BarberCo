# Copy to .env.local for local development
#
# BarberCo.Api launch profile (https):
#   API_BASE_URL=https://localhost:7200/api
# BarberCo.Api launch profile (http only — no TLS workaround needed):
#   API_BASE_URL=http://localhost:5167/api
#
# If using https with the dev cert, also set:
#   NODE_TLS_REJECT_UNAUTHORIZED=0
API_BASE_URL=https://localhost:7200/api
API_KEY=your-api-key-here
